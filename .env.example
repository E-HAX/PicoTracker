# Private attendance console
#
# Generate the hash with:
#   read -s PW; printf '%s' "$PW" | node scripts/hash-password.mjs
#
# Then add the printed line in Vercel:
#   Project -> Settings -> Environment Variables
#
ATTENDANCE_ADMIN_PASSWORD_HASH=

# Add the Upstash Redis / Vercel KV REST credentials. The Vercel
# Marketplace integration can add these automatically.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: session lifetime in hours (default 4, max 24)
# ATTENDANCE_SESSION_HOURS=4

# Optional: separate production/preview data namespaces
# ATTENDANCE_DATA_KEY=cylab:attendance:production:v1
