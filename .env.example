# Private attendance console
#
# Generate the hash with:
#   node scripts/hash-password.mjs
#
# Type your password when prompted; input is hidden.
# Then add the printed line in Vercel:
#   Project -> Settings -> Environment Variables
#
ATTENDANCE_ADMIN_PASSWORD_HASH=

# Storage: create a PRIVATE Vercel Blob store and connect it to the project.
# The connection adds BLOB_STORE_ID and VERCEL_OIDC_TOKEN automatically.
# For local development outside Vercel, set BLOB_READ_WRITE_TOKEN instead.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Optional: session lifetime in hours (default 4, max 24)
# ATTENDANCE_SESSION_HOURS=4

# Optional: isolate production/preview data paths
# ATTENDANCE_BLOB_PATH=attendance/production/state-v1.json
# ATTENDANCE_RATE_BLOB_PATH=attendance/production/rate-v1.json
